/*
 -- Version 34 --
*

resource "compute-type-layout" "kubernetes-1_34-ubuntu-24_04-olvm-amd64-single" {
  code = "kubernetes-1_34-ubuntu-24_04-olvm-amd64-single"
  enabled = true
  name = "MKS Kubernetes 1.34 Cluster on Ubuntu 24.04"
  sortOrder = 1
  computeVersion = "24.04"
  clusterVersion = "1.34.x"
  description = "provision a kubernetes 1.34 cluster on ubuntu 24.04"
  type = {code = "olvm-kube-master"}
  serverCount = 4
  memoryRequirement = 1073741824
  hasAutoScale = true
  containerRuntime = "containerd"
  networkRuntime = "calico"
  computeServers = [
    compute-type-set.kubernetes-ubuntu-24_04-olvm-amd64-set,
    compute-type-set.kubernetes-ubuntu-24_04-worker-olvm-amd64-set
  ]
  groupType = "kubernetes-cluster"
  provisionType =  "olvm-provision-standard"
  optionTypes = [
    {code = "olvm.plugin.provision.datacenter"},
    {code = "olvm.plugin.provision.cloudDatacenter"},
    {code = "olvm.plugin.provision.cluster"},
    {code = "kubernetes.master.podCidr"},
    {code = "kubernetes.master.serviceCidr"}
  ]
  specTemplates = []
  packages = [
    "kubernetes-calico-3-25-0-package",
    "kubernetes-rook-1-15-0-package",
    "kubernetes-fluentbit-3-0-7-package",
    "kubernetes-prometheus-0-12-package",
    "kubernetes-nginx-ingress-operator-1-12-1-package"
  ]
}

